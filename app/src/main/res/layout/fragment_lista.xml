<?xml version="1.0" encoding="utf-8"?>
<!-- Segundo destino: cada botón navega al detalle pasando el nombre del planeta -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:text="@string/elige_planeta"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <Button
        android:id="@+id/btnMercurio"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/mercurio" />

    <Button
        android:id="@+id/btnVenus"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/venus" />

    <Button
        android:id="@+id/btnTierra"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/tierra" />

    <Button
        android:id="@+id/btnMarte"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:text="@string/marte" />

</LinearLayout>
