<?xml version="1.0" encoding="utf-8"?>
<!-- Layout de la única Activity: una Toolbar arriba y el "hueco" donde
     Navigation irá cambiando los Fragments (NavHostFragment) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <!-- el contenedor de navegación.
         - android:name: la clase NavHostFragment, que hace de "marco" para los destinos
         - app:navGraph: el grafo de navegación que va a usar
         - app:defaultNavHost="true": intercepta el botón Atrás del sistema -->
    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/nav_graph" />

</LinearLayout>
